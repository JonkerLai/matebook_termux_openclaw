# ===================================================================
#  pad-agent 配置文件
#  安装后会被复制到 ~/pad-agent/config.env，按需修改
# ===================================================================

# ---------- 网络 ----------
# 平板局域网 IP。留空则自动探测（推荐）
TABLET_IP=""

# 各服务端口
OPENCLAW_PORT=18789
DUFS_PORT=5000
PSTATUS_PORT=8090
SSH_PORT=8022

# ---------- 路径 ----------
# dufs 对外共享的目录
DUFS_SERVE_DIR="$HOME/nas"

# dufs 用户表（用户名:密码:rw|ro）
DUFS_USERS_FILE=""

# ---------- 开关 ----------
# 是否启用 中文桌面 相关（需要 proot Debian + Xfce）
ENABLE_DESKTOP=1

# 是否启用 公网隧道（需要能访问 cloudflare.com）
ENABLE_TUNNEL=1